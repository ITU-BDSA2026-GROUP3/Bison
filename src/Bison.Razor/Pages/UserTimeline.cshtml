@page "/obs/{author}"
@model Bison.Razor.Pages.UserTimelineModel
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
    var routeName = HttpContext.GetRouteValue("author");
}

<div>
    <h2> @routeName's Observations </h2>

    @if (Model.Observations.Any())
    {
        <ul id="messagelist" class="observations">
            @foreach (var ob in Model.Observations)
            {
                <li>
                    <p>
                        <strong>
                             <a asp-page="/UserTimeline"
                                 asp-route-author="@ob.Author">
                                 @ob.Author
                             </a>
                        </strong>
                        @ob.Message
                        <small><em>&mdash; </em>@ob.Timestamp</small>
                    </p>
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no Observations so far.</em>
    }
    <nav aria-label="User timeline pagination">
        @if (Model.HasPreviousPage)
        {
            <a asp-page="/UserTimeline"
                asp-route-author="@Model.AuthorId"
                asp-route-page="@(Model.CurrentPage - 1)">
                Previous
            </a>
        }
        <span>Page @Model.CurrentPage</span>
        @if (Model.HasNextPage)
        {
            <a asp-page="/UserTimeline"
                asp-route-author="@Model.AuthorId"
                asp-route-page="@(Model.CurrentPage + 1)">
                Next
            </a>
        }
    </nav>
</div>
