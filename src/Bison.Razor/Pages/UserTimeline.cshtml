@page "/obs/{authorId}"
@model Bison.Razor.Pages.UserTimelineModel
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";

    /*var currentUserID = User.Find
    var routeName = HttpContext.GetRouteValue("author");*/
    var currentUserID = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;     
        
    var isOwnTimeline = currentUserID != null && currentUserID == Model.author?.Id;
}

<div>
    @if (Model.author == null)
    {
        <em>The given Author doesn't exist.</em>
    }
    else
    {
      

        @if (isOwnTimeline)
        {
            <h2>My Observations</h2>

            <div class ="observationbox">
                <h3>What did you see, @User.Identity?.Name?</h3>
    
                 <form method ="post"
                asp-page-handler="Create"
                asp-route-authorId="@Model.author.Id">
                

                <input type="text"
                style="float: left"
                asp-for ="NewObservationText"
                placeholder="What did you observe"/>

                <span asp-validation-for="NewObservationText"></span>

                    <select asp-for="NewObservationTaxonId"
                         asp-items= "Model.TaxonDropDown">
                    
                    
                    <option value="">-- Select an animal --</option>


                    </select>

                    <span asp-validation-for="NewObservationTaxonId"></span>
                       
                        <input type="submit" value="Share" />
                   
                    </form>

                </div>
           
            }
        else
                {
                    <h2>@Model.author.Name's Observations</h2>
                    
                }
     

        @if (Model.Observations.Any())
        {
            <ul id="messagelist" class="observations">
                @foreach (var ob in Model.Observations)
                {
                    <li>
                        <p>
                            <strong>
                                <a asp-page="/UserTimeline"
                                    asp-route-author="@ob.AuthorName">
                                    <strong>@ob.AuthorName</strong>
                                </a>
                            </strong>
                            @ob.Text
                            <small><em>&mdash; </em>@ob.Timestamp</small>
                        </p>
                    </li>
                }
            </ul>
        }
        else
        {
            <em>There are no Observations so far.</em>
        }
        <nav aria-label="User timeline pagination">
            @if (Model.HasPreviousPage)
            {
                <a asp-page="/UserTimeline"
                    asp-route-author="@Model.author.Id"
                    asp-route-page="@(Model.CurrentPage - 1)">
                    Previous
                </a>
            }
            <span>Page @Model.CurrentPage</span>
            @if (Model.HasNextPage)
            {
                <a asp-page="/UserTimeline"
                    asp-route-author="@Model.author.Id"
                    asp-route-page="@(Model.CurrentPage + 1)">
                    Next
                </a>
            }
        </nav>
    }
</div>