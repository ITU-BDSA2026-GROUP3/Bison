@page
@model Bison.Razor.Pages.Authors.SearchModel
@{
    ViewData["Title"] = "Search authors";
    Layout = "Shared/_Layout";
}

<h1>Search authors</h1>

<form method="get">
    <div class="input-group mb-3">
        <input asp-for="SearchTerm"
               class="form-control"
               placeholder="Enter an author name" />

        <button type="submit" class="btn btn-primary">
            Search
        </button>
    </div>
</form>

@if (Model.HasSearched)
{
    if (Model.Authors.Count == 0)
    {
        <p>No authors were found.</p>
    }
    else
    {
        <ul class="list-group mb-4">
            @foreach (var author in Model.Authors)
            {
                <li class="list-group-item">
                    <a asp-page="./Search"
                       asp-route-SearchTerm="@Model.SearchTerm"
                       asp-route-AuthorId="@author.Id">
                        @author.UserName
                    </a>
                </li>
            }
        </ul>
    }
}

@if (!string.IsNullOrWhiteSpace(Model.AuthorId))
{
    <h2>Post history</h2>

    if (Model.Posts.Count == 0)
    {
        <p>This author has no posts.</p>
    }
    else
    {
        <div class="list-group">
            @foreach (var post in Model.Posts)
            {
                <div class="list-group-item">
                    <strong>@post.GetType().Name</strong>
                    <p class="mb-0">@post.Text</p>
                </div>
            }
        </div>
    }
}