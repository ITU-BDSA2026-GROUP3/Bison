@using Microsoft.AspNetCore.Identity
@using Bison.Razor.domain_model
@inject UserManager<Author> UserManager

<div class="navigation">



	@*This below checks wether the user is logged in,
	if it is true then we continue with this section*@

	@if (User.Identity?.IsAuthenticated == true)
	{
	<div>
            @*User.Identity.Name displays the username*@
              <a href="/obs/@(UserManager.GetUserId(User))">My Observations</a> |


              <a asp-page="/Public">Public Observations</a> |

              <a asp-page="/Account/Logout"
				 asp-route-returnUrl="@Url.Page("/", new { area = "" })"
			    asp-area="Identity" method="post" 
			    >Logout [@(User.Identity.Name)]
			</a>
			    

		</div>
    }
    else
    {
        <div>
           

            <a asp-page="/Public">Public Observations</a> |

            <a asp-area ="Identity"
                asp-page="/Account/Register">Register</a> |

            <a asp-area="Identity"
                asp-page="/Account/Login">Login</a>
        </div>
    }

</div>