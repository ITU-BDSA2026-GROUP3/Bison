<div class="navigation">



@*This below checks wether the user is logged in,
if it is true then we continue with this section*@

@if (User.Identity?.IsAuthenticated == true)
    {
        <div>
            @*User.Identity.Name displays the username*@
              <a href="/@(User.Identity.Name)">My Observations</a> |
              <a href="/obs">Public Observations</a> |

              <form asp-area="Identity"
              asp-page="/Account/Logout"
              method="post">
              <button type="submit">
                Logout [@(User.Identity.Name)]

              </button>

              </form>



        </div>
    }
    else
    {
        <div>
            @*The Register and Login, links to the APS.Net Core 
            Identity pages below*@
            <a href="/obs">Public Observations</a> |
            <a asp-area ="Identity"
                asp-page="/Account/Register">Register</a> |
            <a asp-area="Identity"
                asp-page="/Account/(Login)">Login</a>
        </div>
    }

</div>