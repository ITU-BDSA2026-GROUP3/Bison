@page "/ob/{id?}"
@model Bison.Razor.Pages.ObModel

@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
}

<div>

    @if (Model.Observation == null)
    {
        <h2>All observations</h2>

        @if (Model.Observations.Any())
        {
            <ul id="messagelist" class="observations">

                @foreach(var obs in Model.Observations)
                {
                    <li>

                        <p>
                            
                        <strong>

                            <a asp-page ="/UserTimeline"
                                 asp-route-author ="@obs.Author">
                                 @obs.Author
                            </a>
                        </strong>    

                                    <a asp-page="/Ob"
                                        asp-route-id ="@obs.obsID">
                                        @obs.Message
                                        </a>

                                        <small>
                                            <em>-</em> @obs.Timestamp
                                        </small>
                        </p>
                    </li>
                }
            </ul>
        }
        //If there a no observations yet in the database
        else
        {
             <em> No observations yet, keep observing. </em>
        }
    }
    else
    {
       <h2>Observation @Model.Observation.obsID</h2>

       <p>
        <strong>Author:</strong>
        <a asp-page="/UserTimeline"
        asp-route-author="@Model.Observation.Author">
        @Model.Observation.Author
        </a>
       </p>

       <p>
        <strong>Observation:</strong>
        @Model.Observation.Message
       </p>

       <p>
            <strong>Date:</strong>
            @Model.Observation.Timestamp
       </p>

       <h3>Comments</h3>

        @if (Model.Comments.Any())
        {
            <ul>
                @foreach(var comment in Model.Comments)
                {
                    <li>
                        @comment.Comment
                    </li>
                }
            </ul>
        }
        else
        {
            //If no comments for the observation
            <em>No comments for this observation </em>
        }

        <h3>Proposals</h3>

        @if (Model.Proposals.Any())
        {
            <ul>
                @foreach (var proposal in Model.Proposals)
                {
                    <li>
                        @proposal.taxonID
                    </li>
                }
            </ul>
        }
        else
        {
            //If there are no proposals for this observation
            <em>No proposals for this observation</em>
        }
}
            
</div>
