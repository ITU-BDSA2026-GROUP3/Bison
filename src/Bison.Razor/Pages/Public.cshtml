@page "/obs"
@model Bison.Razor.Pages.PublicModel
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
}

<div>
    
    <h2> Public Observations </h2>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class = "observationbox">

            <h3>Hello what did you see, @User.Identity.Name?</h3>

            <form method= "post" asp-page-handler="Create">

                <div>
                    <input style="float: left"
                           type="text"
                           asp-for="NewObservationText"
                           placeholder="What did you observe?"/>
                </div>

                <div>
                    <label>Select animal:</label>

                    <select asp-for ="NewObservationTaxonId"
                        asp-items="Model.TaxonDropDown">
                       <option value ="">-- Select an animal --</option>
                    </select>
                </div>

                <button type ="submit">Share</button>

            </form>

        </div>
    }

    <form method="get" class="mb-4">
        <div class="form-group" style="max-width: 300px;">
            <label for="taxonSelect" class="form-label">Filter by Taxon:</label>
            
            <select id="taxonSelect" name="taxonId" class="form-control" onchange="this.form.submit()">
                <option value="0">Show All</option>
                @foreach (var taxon in Model.TaxonDropDown)
                {
                    <option value="@taxon.Value" selected="@(taxon.Value == Model.TaxonFilter.ToString())">@taxon.Text</option>
                }
            </select>
        </div>
    </form>
    
    @if (Model.Observations.Any())
    {
        <ul id="messagelist" class="observations">
            @foreach (var obs in Model.Observations)
            {
                <li>
                    <p>
                        <strong>
                            <a asp-page="/UserTimeline"
                               asp-route-author="@obs.AuthorName">
                               @obs.AuthorName
                            </a>
                        </strong>
                        @obs.Text
                        <small><em>&mdash; </em>@obs.Timestamp</small>
                        <img src="/Image/GetImage?id=@obs.Id" alt="Observation image"/>
                    </p>
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no observations so far.</em>
    }
    <nav aria-label="Public timeline pagination">
        @if (Model.HasPreviousPage)
        {
            <a asp-page="/Public"
                asp-route-page="@(Model.CurrentPage - 1)">
                Previous
            </a>
        }
        <span>Page @Model.CurrentPage</span>
        @if (Model.HasNextPage)
        {
            <a asp-page="/Public"
                asp-route-page="@(Model.CurrentPage + 1)">
                Next
            </a>
        }
    </nav>
</div>
