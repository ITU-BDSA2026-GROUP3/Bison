@page "/obs"
@model Bison.Razor.Pages.PublicModel
@{
    ViewData["Title"] = "Bison";
    Layout = "Shared/_Layout";
}

<div>
    <h2> Public Timeline </h2>

    @if (Model.Observations.Any())
    {
        <ul id="messagelist" class="observations">
            @foreach (var obs in Model.Observations)
            {
                <li>
                    <p>
                        <strong>
                            <a asp-page="/UserTimeline"
                               asp-route-author="@obs.AuthorName">
                               @obs.AuthorName
                            </a>
                        </strong>
                        @obs.Text
                        <small><em>&mdash; </em>@obs.Timestamp</small>
                    </p>
                </li>
            }
        </ul>
    }
    else
    {
        <em>There are no observations so far.</em>
    }
    <nav aria-label="Public timeline pagination">
        @if (Model.HasPreviousPage)
        {
            <a asp-page="/Public"
                asp-route-page="@(Model.CurrentPage - 1)">
                Previous
            </a>
        }
        <span>Page @Model.CurrentPage</span>
        @if (Model.HasNextPage)
        {
            <a asp-page="/Public"
                asp-route-page="@(Model.CurrentPage + 1)">
                Next
            </a>
        }
    </nav>
</div>
